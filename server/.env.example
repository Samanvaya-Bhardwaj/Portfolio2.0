# ── Server ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# Comma-separated list of allowed browser origins (Vite dev server by default)
CLIENT_ORIGIN=http://localhost:5173

# ── Database ───────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# ── Auth ───────────────────────────────────────────────
# Use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=12h

# Admin account created/updated by `npm run seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_NAME=Samanvaya Bhardwaj
